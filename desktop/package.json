{
  "name": "sgbus-timings-desktop",
  "productName": "SG Bus Timings",
  "version": "2.2.8",
  "description": "SG Bus Timings for Windows, macOS and Linux: the site at sgbus.uwuapps.org in its own window, with a tray icon and Service Alerts as desktop notifications.",
  "author": "UwU Apps <augybiz@gmail.com>",
  "homepage": "https://sgbus.uwuapps.org",
  "license": "MIT",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis:x64 nsis:arm64 msi:x64 --publish never",
    "build:linux": "electron-builder --linux deb rpm AppImage --x64 --arm64 --publish never",
    "build:mac": "electron-builder --mac dmg zip --x64 --arm64 --publish never"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "org.uwuapps.sgbus",
    "productName": "SG Bus Timings",
    "copyright": "UwU Apps",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "widgets.js",
      "glance.js",
      "location.js",
      "links.js",
      "settings.js",
      "offline.html",
      "splash.html",
      "titlebar.html",
      "titlebar.js",
      "titlebar-preload.js",
      "build/tray.png",
      "build/tray@2x.png",
      "build/tray@3x.png",
      "build/icon.png"
    ],
    "artifactName": "sg-bus-timings-${version}${suffix}.${ext}",
    "protocols": [
      {
        "name": "SG Bus Timings link",
        "schemes": [
          "uwu"
        ]
      }
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/augy-studios/sgbus-timings/releases/latest/download"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "sg-bus-timings-${version}-setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "SG Bus Timings"
    },
    "msi": {
      "artifactName": "sg-bus-timings-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "SG Bus Timings"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.travel",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "sg-bus-timings-${version}-mac-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSLocationUsageDescription": "SG Bus Timings uses your location to find the bus stops near you and to follow your trip.",
        "NSLocationWhenInUseUsageDescription": "SG Bus Timings uses your location to find the bus stops near you and to follow your trip."
      }
    },
    "dmg": {
      "artifactName": "sg-bus-timings-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Utility",
      "synopsis": "Live Singapore bus timings, routes and journeys",
      "executableName": "sgbus-timings",
      "maintainer": "UwU Apps <augybiz@gmail.com>",
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "deb": {
      "artifactName": "sg-bus-timings-${version}-${arch}.${ext}"
    },
    "rpm": {
      "artifactName": "sg-bus-timings-${version}-${arch}.${ext}"
    },
    "appImage": {
      "artifactName": "sg-bus-timings-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
