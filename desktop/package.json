{
  "name": "sgbus-timings-desktop",
  "productName": "SG Bus Timings",
  "version": "2.0.1",
  "description": "SG Bus Timings for Windows and Linux: the site at sgbus.uwuapps.org in its own window, with a tray icon and Service Alerts as desktop notifications.",
  "author": "UwU Apps <augybiz@gmail.com>",
  "homepage": "https://sgbus.uwuapps.org",
  "license": "MIT",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis msi --x64",
    "build:linux": "electron-builder --linux deb AppImage --x64"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "org.uwuapps.sgbus",
    "productName": "SG Bus Timings",
    "copyright": "UwU Apps",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "offline.html",
      "build/tray.png",
      "build/icon.png"
    ],
    "artifactName": "sg-bus-timings-${version}${suffix}.${ext}",
    "protocols": [
      {
        "name": "SG Bus Timings link",
        "schemes": [
          "uwu"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "msi"
      ]
    },
    "nsis": {
      "artifactName": "sg-bus-timings-${version}-setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "SG Bus Timings"
    },
    "msi": {
      "artifactName": "sg-bus-timings-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "SG Bus Timings"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Utility",
      "synopsis": "Live Singapore bus timings, routes and journeys",
      "executableName": "sgbus-timings",
      "maintainer": "UwU Apps <augybiz@gmail.com>",
      "target": [
        "deb",
        "AppImage"
      ]
    },
    "deb": {
      "artifactName": "sg-bus-timings-${version}-amd64.${ext}"
    },
    "appImage": {
      "artifactName": "sg-bus-timings-${version}-x86_64.${ext}"
    }
  }
}
