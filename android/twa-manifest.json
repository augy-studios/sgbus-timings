{
  "packageId": "org.uwuapps.sgbus",
  "host": "sgbus.uwuapps.org",
  "name": "SG Bus Timings by UwU Apps",
  "launcherName": "SG Bus Timings",
  "display": "standalone",
  "orientation": "any",
  "themeColor": "#ccffcc",
  "themeColorDark": "#ccffcc",
  "navigationColor": "#ccffcc",
  "navigationColorDark": "#0c100e",
  "navigationDividerColor": "#ccffcc",
  "navigationDividerColorDark": "#0c100e",
  "backgroundColor": "#ccffcc",
  "enableNotifications": true,
  "startUrl": "/",
  "iconUrl": "https://sgbus.uwuapps.org/sgbusicon1.png",
  "monochromeIconUrl": "https://sgbus.uwuapps.org/sgbusnotificon.png",
  "appVersion": "1.0.0",
  "appVersionCode": 1,
  "signingKey": {
    "path": "./android.keystore",
    "alias": "sgbus"
  },
  "splashScreenFadeOutDuration": 300,
  "enableSiteSettingsShortcut": true,
  "isChromeOSOnly": false,
  "isMetaQuest": false,
  "fullScopeUrl": "https://sgbus.uwuapps.org/",
  "minSdkVersion": 21,
  "targetSdkVersion": 35,
  "generatorApp": "bubblewrap-cli",
  "webManifestUrl": "https://sgbus.uwuapps.org/manifest.json",
  "fallbackType": "customtabs",
  "features": {
    "locationDelegation": {
      "enabled": true
    },
    "playBilling": {
      "enabled": false
    },
    "firstRunFlag": {
      "enabled": false,
      "queryParameterName": "firstrun"
    },
    "notifications": {
      "enabled": true
    }
  },
  "alphaDependencies": {
    "enabled": false
  },
  "shareTarget": {
    "action": "/",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "retainedBundles": [],
  "additionalTrustedOrigins": [],
  "shortcuts": [
    {
      "name": "Stops near me",
      "shortName": "Near me",
      "url": "https://sgbus.uwuapps.org/#near",
      "chosenIconUrl": "https://sgbus.uwuapps.org/images/icons/shortcut-near.png"
    },
    {
      "name": "Navigate",
      "shortName": "Navigate",
      "url": "https://sgbus.uwuapps.org/#nav",
      "chosenIconUrl": "https://sgbus.uwuapps.org/images/icons/shortcut-nav.png"
    },
    {
      "name": "Service alerts",
      "shortName": "Alerts",
      "url": "https://sgbus.uwuapps.org/#alerts",
      "chosenIconUrl": "https://sgbus.uwuapps.org/images/icons/shortcut-alerts.png"
    }
  ]
}
