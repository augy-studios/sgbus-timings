# The signing key and its passwords: never in git. Back them up somewhere safe; an APK signed
# with a different key can't update one already installed.
android.keystore
*.keystore
*.jks
keystore.properties

# Firebase's settings for the app (FIREBASE-SETUP.md): not secret, but your project's own.
google-services.json

# Flutter's and Dart's: the packages fetched (pubspec.lock is kept), and everything built.
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
*.iml
.idea/

# Left on disk by the Capacitor app this one replaced: its packages and its old Android project
# (mostly build output). Flutter uses neither; the Wear OS app now lives in android/wear/.
/node_modules/
/native/

# Built apps
*.apk
*.aab
*.idsig
