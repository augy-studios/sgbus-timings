<?xml version="1.0" encoding="utf-8"?>
<!-- SG Bus Timings for Android: see android/README.md for what each part is for. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Location: the site's own (Near me, Navigate, the live map), and the trip being followed
         with the screen off (TripService). "All the time" is asked once, on the first trip. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Service Alerts and the Get Off Alert (Notifications.java), and its buzz. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- The phone's calendar, for Navigate's Calendar tab (PhoneCalendarPlugin). Asked for only
         when you choose it. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- A card's value (CardPlugin). Phones without NFC still install the app. -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- The app updating itself from GitHub (UpdateActivity.java). Each update still asks you on
         Android's own install screen. Not allowed on Google Play: drop it for a Play build. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- The apps OpenAppActivity opens, which Android 11 and later hide from this app unless
         they're named here. -->
    <queries>
        <package android:name="sg.com.transitlink" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- Firebase's notifications (Service Alerts and the server's Get Off Alert) use these
             unless the push names its own (main-site/api/_push/fcm.js). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification_icon" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="alerts" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- The site's own links open in the app: Android checks the site lists this app's
                 signing key in main-site/.well-known/assetlinks.json. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="sgbus.uwuapps.org" />
            </intent-filter>

            <!-- uwu://sgbus/ links (MainActivity.fromAppLink). Only the sgbus host, so UwU Apps'
                 other apps can answer uwu:// links of their own. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="uwu" android:host="sgbus" />
            </intent-filter>

            <!-- Sharing a place into Navigate, from Google Maps and the like. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <!-- Opens another app, such as SimplyGo, for the site's button (OpenAppActivity.java).
             Shows nothing, and leaves no trace in recents or this app's task. -->
        <activity android:name=".OpenAppActivity"
            android:exported="true"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="org.uwuapps.sgbus" android:host="open" />
            </intent-filter>
        </activity>

        <!-- The app updating itself, for the site's update bar (UpdateActivity.java), and the
             installer's answers to it, which no other app may send (not exported). -->
        <activity android:name=".UpdateActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:theme="@style/UpdateTheme">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="org.uwuapps.sgbus" android:host="update" />
            </intent-filter>
        </activity>
        <receiver android:name=".UpdateActivity$InstallStatus"
            android:exported="false" />

        <!-- The Bus timings widget (TimingsWidget.java), its rows, and its setup. -->
        <receiver android:name=".TimingsWidget"
            android:label="@string/widget_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/timings_widget_info" />
        </receiver>
        <service android:name=".TimingsWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />
        <activity android:name=".WidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/UpdateTheme">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- The trip being followed (TripService.java). Ends with the app swiped away. -->
        <service android:name=".TripService"
            android:exported="false"
            android:foregroundServiceType="location"
            android:stopWithTask="true" />
    </application>
</manifest>
