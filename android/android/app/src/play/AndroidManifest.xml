<?xml version="1.0" encoding="utf-8"?>
<!-- A Google Play build only (build-apk.ps1 -Aab, app/build.gradle's sgbusPlay): Play updates the app
     and doesn't allow it to update itself, so the updater and its permission come out. The APK on
     GitHub keeps them. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />
    <application>
        <activity android:name=".UpdateActivity" tools:node="remove" />
        <receiver android:name=".UpdateActivity$InstallStatus" tools:node="remove" />
    </application>
</manifest>
