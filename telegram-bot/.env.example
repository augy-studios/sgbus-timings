# Telegram bot token from @BotFather
BOT_TOKEN=

# Telegram API credentials for the MTProto client (Telethon), from
# https://my.telegram.org/apps - required even for bot logins
API_ID=
API_HASH=

# LTA DataMall AccountKey, request one at
# https://datamall.lta.gov.sg/content/datamall/en/request-for-api.html
LTA_ACCOUNT_KEY=

# Path to the SQLite database file (created automatically if missing)
DB_PATH=./data/bot.db

# Button shown on /start that opens the companion web app
WEBAPP_URL=https://sgbus.uwuapps.org/

# Button shown on /start that links to the donation page
DONATE_URL=https://donate.stripe.com/28o2akeAr3hv0DK6oo

# Button shown on /start that opens the how-to guide for the bot
GUIDE_URL=https://guide.sgbus.uwuapps.org/bot/start

# How often (in hours) to refresh the cached bus stop list from LTA DataMall
BUS_STOPS_REFRESH_HOURS=24

# How often (in seconds) to check LTA's train alerts and traffic incidents for
# Service Alerts (/sub). The scheduler looks for due jobs once a minute, so
# anything under 60 behaves as 60.
SERVICE_ALERT_POLL_SECONDS=60

# OneMap account, for looking up postal codes. The bot trades these for an API
# token and renews it every 3 days. Optional: left blank, lookups go without a
# token, which OneMap still answers. Register at https://www.onemap.gov.sg/apidocs/
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

# /nav asks the site's /api/nav and /api/places for its journeys. Defaults to WEBAPP_URL.
NAV_API_URL=

# Any long random string, the same as BOT_API_TOKEN on the site's Vercel project. Lets the
# bot's navs past the site's per-IP limit, which every chat would otherwise share.
BOT_API_TOKEN=
