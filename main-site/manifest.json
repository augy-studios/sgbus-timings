{
    "name": "SG Bus Timings by UwU Apps",
    "short_name": "SG Bus Timings",
    "description": "Live Singapore bus arrivals, bus routes, and journeys by bus and train between any two places.",
    "icons": [{
        "src": "sgbusicon1.png",
        "type": "image/png",
        "sizes": "512x512"
    }],
    "screenshots": [{
            "src": "/images/screenshot_1.png",
            "type": "image/png",
            "sizes": "1560x3380"
        },
        {
            "src": "/images/screenshot_2.png",
            "type": "image/png",
            "sizes": "3840x1976"
        }
    ],
    "start_url": "/",
    "theme_color": "#cfc",
    "background_color": "#cfc",
    "display": "standalone",
    "display_override": ["fullscreen", "minimal-ui", "window-controls-overlay"],
    "orientation": "any",
    "id": "sgbus",
    "dir": "ltr",
    "scope": "/",
    "lang": "en",
    "categories": [
        "productivity",
        "lifestyle",
        "utilities"
    ],
    "shortcuts": [{
            "name": "Stops near me",
            "short_name": "Near me",
            "description": "Live bus timings at the stops around you",
            "url": "/#near",
            "icons": [{ "src": "/images/icons/shortcut-near.png", "type": "image/png", "sizes": "192x192" }]
        },
        {
            "name": "Navigate",
            "short_name": "Navigate",
            "description": "From any place to any other by bus and train",
            "url": "/#nav",
            "icons": [{ "src": "/images/icons/shortcut-nav.png", "type": "image/png", "sizes": "192x192" }]
        },
        {
            "name": "Service alerts",
            "short_name": "Alerts",
            "description": "Train disruptions and traffic incidents right now",
            "url": "/#alerts",
            "icons": [{ "src": "/images/icons/shortcut-alerts.png", "type": "image/png", "sizes": "192x192" }]
        }
    ],
    "widgets": [{
        "name": "Bus timings",
        "short_name": "Bus timings",
        "description": "Live arrivals at a bus stop you pick, for every bus there or just the ones you choose",
        "tag": "timings",
        "ms_ac_template": "/widgets/timings.json",
        "data": "/widgets/timings-data.json",
        "type": "application/json",
        "screenshots": [{ "src": "/widgets/screenshot.png", "sizes": "600x400", "label": "The Bus timings widget showing the next buses at a stop" }],
        "icons": [{ "src": "/images/icons/widget-bus.png", "type": "image/png", "sizes": "192x192" }],
        "auth": false,
        "update": 60,
        "multiple": true
    }]
}