# Copy to .env.local for `vercel dev`, and set the same names under the Vercel
# project's Settings → Environment Variables for deploys.

# LTA DataMall AccountKey, request one at
# https://datamall.lta.gov.sg/content/datamall/en/request-for-api.html
# Every /api route needs it: arrivals, stops, routes, service info and service alerts.
LTA_ACCOUNT_KEY=

# OneMap account, for looking up postal codes (/api/postal-code). The function
# trades these for an API token and renews it every 3 days. Optional: left
# blank, lookups go without a token, which OneMap still answers. Register at
# https://www.onemap.gov.sg/apidocs/
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

# ---- Service Alerts notifications (/api/push). See SERVICE-ALERTS-SETUP.md. ----

# Upstash Redis. Connecting it from the Vercel Marketplace sets these two; the
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN pair from upstash.com works too.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# From `npx web-push generate-vapid-keys`. Generate once and keep them: new
# keys invalidate every existing subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# How push services can reach you if something goes wrong. mailto: or https:.
VAPID_SUBJECT=mailto:you@example.com

# Any long random string. Vercel Cron sends it to /api/push/poll, which refuses
# calls without it.
CRON_SECRET=

# ---- Weather button (/api/weather) ----

# data.gov.sg API key, for PSI and PM2.5. Optional: without it the readings still come,
# at data.gov.sg's lower rate limit.
DATA_GOV_KEY=

# ---- Navigate (/api/nav, /api/places) ----

# Any long random string, the same as BOT_API_TOKEN in the Telegram bot's .env. The bot's
# /nav sends it, so its requests aren't held to the per-IP limit every chat would share.
BOT_API_TOKEN=
