{
    "functions": {
        "api/bus-routes.js": { "maxDuration": 60 },
        "api/push/poll.js": { "maxDuration": 300 },
        "api/push/trip-poll.js": { "maxDuration": 60 },
        "api/nav.js": { "maxDuration": 60 },
        "api/places.js": { "maxDuration": 30 },
        "api/calendar.js": { "maxDuration": 60 },
        "api/traffic.js": { "maxDuration": 120 }
    },
    "rewrites": [
        { "source": "/go/:id", "destination": "/api/share-page?id=:id" },
        { "source": "/trip/:id", "destination": "/api/share-page?id=:id" },
        { "source": "/eta/:id", "destination": "/api/share-page?id=:id" }
    ],
    "crons": [
        { "path": "/api/push/poll", "schedule": "* * * * *" },
        { "path": "/api/push/trip-poll", "schedule": "* * * * *" },
        { "path": "/api/traffic", "schedule": "*/5 * * * *" }
    ]
}
