b, and the wait there, cheapest per stop, keyed the same way.\n  function changeAt(g, at) {\n    const out = new Map();\n    for (const [stop, { cost, parts }] of at) {\n      for (const [other, walkM] of changeNear(g, stop)) {\n        const total = cost + changeWalk(walkM) + CHANGE_PENALTY_MIN;\n        if (!out.has(other) || total < out.get(other).cost) out.set(other, { cost: total, parts });\n      }\n    }\n    return out;\n  }\n\n  // [stop, metres] for the stops across the road from this one, nearest first.\n  function acrossTheRoad(code) {\n    const g = BusNet.graph();\n    ensureGrid(g);\n    const road = g.roads[code];\n    if (!road) return [];\n    return near(g, code)\n      .filter(([other, metres]) => metres <= ACROSS_ROAD_M && g.roads[other] === road)\n      .sort((a, b) => a[1] - b[1]);\n  }\n\n  // The stop across the road that each end of a route was most likely meant to be, as\n  // { start: { code, metres }, end: { code, metres } }, leaving out an end that looks right.\n  //\n  // An end looks wrong when the quickest journey boards or gets off across the road from it,\n  // and staying put at the end as given is at least WRONG_SIDE_MIN slower, or can't be done\n  // at all: the stop on the side of the road the buses don't go your way from. A minute or\n  // two either way is just a choice of buses, not the wrong stop.\n  function wrongSideEnds(startCode, endCode) {\n    const ranked = rankedJourneys(startCode, endCode);\n    if (!ranked.length) return {};\n    const { cost: bestCost, legs: best } = ranked[0];\n    const fixes = {};\n    for (const [field, code, used, stayPut] of [\n      ['start', startCode, best[0].from, { walkStart: false }],\n      ['end', endCode, best[best.length - 1].to, { walkEnd: false }],\n    ]) {\n      const across = acrossTheRoad(code).find(([other]) => other === used);\n      if (!across) continue;\n      const own = rankedJourneys(startCode, endCode, stayPut);\n      if (own.length && own[0].cost - bestCost < WRONG_SIDE_MIN) continue;\n      fixes[field] = { code: used, metres: across[1] };\n    }\n    return fixes;\n  }\n\n  // How long a leg is: the stops it rides and roughly how many minutes that takes. Null\n  // when the bus no longer runs that way, for a journey kept from before a route change.\n  function legDetails(leg) {\n    const run = runOf(leg);\n    if (!run) return null;\n    const i = run.stops.indexOf(leg.from);\n    const j = i === -1 ? -1 : run.stops.indexOf(leg.to, i + 1);\n    if (j === -1) return null;\n    return { stops: j - i, minutes: rideMin(run, i, j) };\n  }\n\n  // Where a leg crosses the Causeway, to get off for immigration and on again: [{ way: 'out' |\n  // 'in', from, to, minutes }], `from` the checkpoint you get off at and `to` the one across.\n  function legCrossings(leg) {\n    const run = runOf(leg);\n    if (!run) return [];\n    const i = run.stops.indexOf(leg.from);\n    const j = run.stops.indexOf(leg.to, i + 1);\n    return run.cross\n      .filter(([c]) => c > i && c <= j)\n      .map(([c, way]) => ({ way, from: run.stops[c - 1], to: run.stops[c], minutes: BusNet.customs[way] }));\n  }\n\n  // The walk between two stops, or null when they're the same stop.\n  function walkDetails(fromCode, toCode) {\n    if (fromCode === toCode) return null;\n    const { coords } = BusNet.graph();\n    const metres = coords[fromCode] && coords[toCode] ? BusNet.haversine(coords[fromCode], coords[toCode]) : 0;\n    return { metres, minutes: walkMin(metres) };\n  }\n\n  // Time on the move, riding and walking but not waiting, for the whole journey.\n  function journeyMinutes(legs, startCode, endCode) {\n    let total = 0;\n    let here = startCode;\n    for (const leg of legs) {\n      const details = legDetails(leg);\n      if (!details) return null;\n      total += details.minutes + (walkDetails(here, leg.from)?.minutes || 0);\n      here = leg.to;\n    }\n    return total + (walkDetails(here, endCode)?.minutes || 0);\n  }\n\n  window.Journeys = { directServices, directRides, findJourneys, wrongSideEnds, legDetails, legCrossings, walkDetails, journeyMinutes, journeyClock, ESTIMATE_NOTE };\n})();\n","contractions.js":"// LTA's shortened words in stop and road names (\"W'lands Checkpt\", \"Bt Batok\", \"Opp Blk 10\"),\n// so a search finds a stop however the word is typed: Bukit finds \"Bt Batok Int\", and Ave\n// finds \"Avenue 3\". Each group is one word's forms, and a word typed as any of them is matched\n// as all of them. LTA is not consistent (Ctr and Ctrl both stand for Centre and Central), so\n// some groups are wider than one word. The long forms are matched too, since a few road names\n// keep them (\"Lower Peirce Reservoir\", \"Upper Bukit Timah Rd\").\n//\n// Contractions.matcher(query) gives { test(text), words(text), note(texts) }, or null for an\n// empty query: `test` is whether a stop's lowercased name and road match the query in one\n// piece with its words swapped for their other forms, `words` whether they match it word by\n// word, and `note` the line saying which forms were searched, from the ones the stops it's\n// given actually have. The same as GROUPS and Matcher in the Telegram bot's contractions.py.\n// Plain script: this project does not use ES modules, so it goes on the global object, which\n// is window in the browser and in the CLI's sandbox. /api/places imports it as it is, for\n// Navigate's stops (api/_lib/stop-search.js), where there's no window.\n(function () {\n  const GROUPS = [\n    [\"Woodlands\", \"W'lands\"], [\"Serangoon\", \"S'goon\"], [\"Singapore\", \"S'pore\"],\n    [\"Commonwealth\", \"C'wealth\"], [\"Aerospace\", \"A'space\"],\n    [\"Choa Chu Kang\", \"Chua Chu Kang\", \"CCK\"], [\"Holland Village\", \"Holland V\"],\n    [\"Bukit\", \"Bt\"], [\"Jalan\", \"Jln\"], [\"Tanjong\", \"Tanjung\", \"Tg\"], [\"Kampong\", \"Kampung\", \"Kg\"],\n    [\"Sungei\", \"Sg\"], [\"Upper\", \"Upp\"], [\"North\", \"Nth\"], [\"South\", \"Sth\"],\n    [\"Avenue\", \"Ave\"], [\"Street\", \"St\"], [\"Saint\", \"St\"], [\"Road\", \"Rd\"], [\"Drive\", \"Dr\"],\n    [\"Crescent\", \"Cres\"], [\"Place\", \"Pl\"], [\"Walk\", \"Wk\"], [\"Close\", \"Cl\"], [\"Court\", \"Ct\"],\n    [\"Terrace\", \"Terr\"], [\"Square\", \"Sq\"], [\"Park\", \"Pk\"], [\"Mount\", \"Mt\"],\n    [\"Garden\", \"Gdn\"], [\"Gardens\", \"Gdns\"], [\"Reservoir\", \"Resvr\"],\n    [\"After\", \"Aft\"], [\"Before\", \"Bef\"], [\"Opposite\", \"Opp\"], [\"Block\", \"Blk\"],\n    [\"Interchange\", \"Int\"], [\"Terminal\", \"Ter\"], [\"Station\", \"Stn\"], [\"Checkpoint\", \"Checkpt\"],\n    [\"Carpark\", \"Car Park\", \"Car-park\", \"Parking\", \"CP\"], [\"Playground\", \"P/G\"],\n    [\"Centre\", \"Center\", \"Central\", \"Ctr\", \"Ctrl\"], [\"Market\", \"Mkt\"], [\"Food Court\", \"FC\"],\n    [\"Shopping\", \"Shop\"], [\"Complex\", \"Cplx\"], [\"Building\", \"Bldg\"], [\"Tower\", \"Twr\"],\n    [\"House\", \"Hse\"], [\"Warehouse\", \"Warehse\"], [\"Library\", \"Lib\"], [\"Post Office\", \"PO\"],\n    [\"Cemetery\", \"Cemy\"], [\"Hospital\", \"Hosp\"], [\"Rehabilitation\", \"Rehab\", \"Reh\"], [\"Release\", \"Rel\"],\n    [\"School\", \"Sch\"], [\"Primary\", \"Pr\"], [\"Secondary\", \"Sec\"], [\"College\", \"Coll\"],\n    [\"Polytechnic\", \"Poly\"], [\"Institute\", \"Inst\"], [\"Institution\", \"Instn\"], [\"Academy\", \"Acad\"],\n    [\"Aviation Academy\", \"Aviation Ac\"], [\"Methodist\", \"Meth\"], [\"Church\", \"Ch\"], [\"Temple\", \"Tp\"],\n    [\"Mosque\", \"Masjid\", \"Mque\", \"Mjd\"],\n    [\"Industrial\", \"Industry\", \"Ind\"], [\"Technology\", \"Tech\"], [\"Science\", \"Sci\"],\n    [\"Engineering\", \"Engrg\"], [\"Manufacturing\", \"Mfg\"], [\"Processing\", \"Proc\"], [\"Facility\", \"Fty\"],\n    [\"Service\", \"Svc\"], [\"Services\", \"Svcs\"], [\"Business\", \"Biz\"], [\"Corporation\", \"Corp\"],\n    [\"Group\", \"Grp\"], [\"Limited\", \"Ltd\"], [\"Private\", \"Pte\"], [\"General\", \"Gen\"],\n    [\"National\", \"Natl\"], [\"International\", \"Intl\"],\n  ];\n  // The most words in any one form.\n  const MAX_WORDS = 3;\n\n  // How a form or a typed word is looked up: lowercased, without apostrophes (so \"wlands\"\n  // finds W'lands) or a trailing full stop (\"St.\", \"Reh.\").\n  const key = (s) => s.toLowerCase().replace(/'/g, '').replace(/\\.$/, '');\n  const escape = (s) => s.replace(/[.*+?^${}()|[\\]\\\\/]/g, '\\\\$&');\n  // A form in a name: its apostrophe optional, its words apart by spaces or a hyphen.\n  const pattern = (form) => form.toLowerCase().split(/[ -]+/).map((w) => escape(w).replace(/'/g, \"'?\")).join('[ -]+');\n\n  // Each form's key, to every form it stands for, across all the groups it's in (\"St\" is in\n  // both Street's and Saint's).\n  const FORMS = new Map();\n  for (const group of GROUPS) {\n    for (const form of group) {\n      const k = key(form);\n      FORMS.set(k, [...new Set([...(FORMS.get(k) || []), ...group])]);\n    }\n  }\n\n  // Not inside a longer word, so St doesn't match \"West\" and Pr not \"Prince\", and maybe with\n  // a full stop after, as \"St. Andrew's\".\n  const END = '(?![a-z0-9])\\\\.?';\n  const START = '(?:^|[^a-z0-9])';\n\n  function matcher(query) {\n    const words = query.trim().split(/\\s+/).filter(Boolean);\n    if (!words.length) return null;\n    const parts = [];\n    let swapped = false;\n    for (let i = 0; i < words.length;) {\n      let n = Math.min(MAX_WORDS, words.length - i);\n      while (n > 0 && !FORMS.has(key(words.slice(i, i + n).join(' ')))) n--;\n      if (n) {\n        const typed = words.slice(i, i + n).join(' ');\n        parts.push({ typed, forms: FORMS.get(key(typed)) });\n        swapped = true;\n        i += n;\n      } else {\n        parts.push({ literal: words[i].toLowerCase() });\n        i++;\n      }\n    }\n    const forms = (p) => `(?:${p.forms.map(pattern).join('|')})${END}`;\n\n    // In one piece, words apart by spaces only: a stop's name and road are apart by a line\n    // break, and a query isn't matched across the two.\n    const whole = swapped\n      ? new RegExp(parts.map((p, i) => p.literal != null ? escape(p.literal) : `${i === 0 ? START : ''}${forms(p)}`).join(' +'))\n      : null;\n    // Word by word, in any order and across name and road, so \"blk 109 bedok\" finds Blk 109\n    // on Bedok Nth Rd. Each word starts one of the stop's words, and each but the last, which\n    // may still be being typed, is all of it: 109 doesn't find Blk 1090, or Blk 2109.\n    const each = parts.length > 1\n      ? parts.map((p, i) => new RegExp(START + (p.literal != null\n        ? escape(p.literal) + (i < parts.length - 1 ? END : '')\n        : forms(p))))\n      : null;\n\n    return {\n      // Whether a stop's lowercased name and road match in one piece with words swapped for\n      // their other forms: false for a query with none to swap, matched as typed instead.\n      test: (text) => !!whole?.test(text),\n      // Whether they match word by word: false for a query of one word.\n      words: (text) => !!each?.every((re) => re.test(text)),\n      // \"Also searched Bt for Bukit\": only the forms the stops given really have, other than\n      // the one typed.\n      note(texts) {\n        const found = [];\n        for (const p of parts) {\n          if (!p.forms) continue;\n          const others = p.forms.filter((f) => key(f) !== key(p.typed) &&\n            texts.some((t) => new RegExp(`${START}${pattern(f)}${END}`).test(t)));\n          // The word typed as the group spells it, since the query's been lowercased.\n          const typed = p.forms.find((f) => key(f) === key(p.typed)) || p.typed;\n          if (others.length) found.push(`${others.join(', ')} for ${typed}`);\n        }\n        return found.length ? `Also searched ${found.join('; ')}` : '';\n      },\n    };\n  }\n\n  globalThis.Contractions = { matcher };\n})();\n","station-search.js":"// MRT and LRT stations and their exits, so a search for \"Bedok MRT\" or \"Senja LRT\" lists the\n// bus stops at the station. LTA names those stops \"Bedok Stn\", or after a block or a road,\n// never \"MRT\", so they're found by how close they are to an exit instead. The same as the\n// Telegram bot's stations.py and bus_stops_at_station.\n//\n// The stations are /data/rail-stations.json, from sgraildata (scripts/vendor-rail.mjs),\n// fetched with the stop list (StationSearch.load). Until it's in, a search for a station is\n// a search of stop names like any other.\n// Plain script: this project does not use ES modules, so it goes on window.\n(function () {\n  // How far from an exit a stop can be and still count as at the station: across the road\n  // and a little way along it.\n  const RADIUS_M = 250;\n  // \"Bedok MRT\", \"Bedok MRT station\", \"Senja LRT\", \"Bedok station\". Not \"Bedok Stn\": that's\n  // how LTA names stops, so it stays a search of their names.\n  const QUERY_RE = /^(.+?)\\s+(?:(?:mrt|lrt)(?:\\s+(?:station|stn))?|station)\\.?$/i;\n  // Line code prefixes of the LRT lines: Bukit Panjang, Sengkang and Punggol.\n  const LRT_PREFIXES = ['BP', 'SW', 'SE', 'STC', 'PW', 'PE', 'PTC'];\n\n  let stations = null;\n  let loading = null;\n\n  function load() {\n    loading ??= fetch('/data/rail-stations.json')\n      .then((r) => (r.ok ? r.json() : Promise.reject(new Error(String(r.status)))))\n      .then((data) => { stations = data.stations; })\n      .catch(() => { loading = null; });\n    return loading;\n  }\n\n  const nameKey = (s) => s.toLowerCase().replace(/'/g, '').split(/\\s+/).filter(Boolean).join(' ');\n\n  // The station a search like \"Bedok MRT\" asks for: the one of that name, or else the only\n  // one whose name starts with it (\"Botanic MRT\"). Null for any other search, one that could\n  // be several stations, or before the stations are in.\n  function find(query) {\n    const m = stations && query.trim().match(QUERY_RE);\n    if (!m) return null;\n    const wanted = nameKey(m[1]);\n    const exact = stations.find((s) => nameKey(s.name) === wanted);\n    if (exact) return exact;\n    const starts = stations.filter((s) => nameKey(s.name).startsWith(wanted));\n    return starts.length === 1 ? starts[0] : null;\n  }\n\n  // \"Bedok MRT station\", \"Senja LRT station\", or both for an interchange like Choa Chu Kang.\n  function label(station) {\n    const lrt = station.codes.some((c) => LRT_PREFIXES.some((p) => c.startsWith(p)));\n    const mrt = station.codes.some((c) => !LRT_PREFIXES.some((p) => c.startsWith(p)));\n    return `${station.name} ${lrt && mrt ? 'MRT/LRT' : lrt ? 'LRT' : 'MRT'} station`;\n  }\n\n  // Each station's stops, worked out once per stop list rather than on every keystroke.\n  let made = new WeakMap();\n  let madeFor = null;\n\n  // The stops within RADIUS_M of any of the station's exits (or the station itself, where\n  // none are known), nearest first, as { code, distance } from the closest exit.\n  function stopsAt(station, stopsIndex, distance) {\n    if (madeFor !== stopsIndex) { made = new WeakMap(); madeFor = stopsIndex; }\n    if (!made.has(station)) made.set(station, work(station, stopsIndex, distance));\n    return made.get(station);\n  }\n\n  function work(station, stopsIndex, distance) {\n    const points = station.exits.length ? station.exits : [[station.lat, station.lng]];\n    const out = [];\n    for (const [code, s] of Object.entries(stopsIndex || {})) {\n      const ds = points.map(([lat, lng]) => distance(lat, lng, s.lat, s.lng)).filter((d) => d != null);\n      const d = ds.length ? Math.min(...ds) : null;\n      if (d != null && d <= RADIUS_M) out.push({ code, distance: d });\n    }\n    return out.sort((a, b) => a.distance - b.distance);\n  }\n\n  // Every station, once they're in (null before): Navigate's places offline (js/nav.js).\n  const all = () => stations;\n\n  window.StationSearch = { load, find, label, stopsAt, all };\n})();\n","mrt-stations.js":"// MRT and LRT station names and line labels, for the Service Alerts card.\n// Generated from sgmrt-alerts (telegram-bot/src/statio