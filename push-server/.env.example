# Copy to /etc/sgbus-push.env on the VPS (or .env for local testing) and fill in.

# From `npx web-push generate-vapid-keys`. Generate once and keep them: new
# keys invalidate every existing subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# How push services can reach you if something goes wrong. mailto: or https:.
VAPID_SUBJECT=mailto:you@example.com

# LTA DataMall AccountKey, the same one the bot and the site use.
LTA_ACCOUNT_KEY=

# How often to check LTA's train alerts and traffic incidents, in seconds.
POLL_SECONDS=60

# Sites allowed to call the API, comma separated.
ALLOWED_ORIGINS=https://sgbus.uwuapps.org

# 8787 is alarm-clock's push server on the same VPS.
PORT=8788
HOST=127.0.0.1
